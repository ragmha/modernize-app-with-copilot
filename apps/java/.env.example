# Reference variable names only. The repository lab command creates the local
# environment file at the repository root. Never commit real credentials.
# Supply distinct, generated passwords; blank values below are NOT defaults.

# Oracle SYS/SYSTEM administrator password (required)
ORACLE_PASSWORD=

# Application database schema user (the user name is not a secret)
APP_USER=photoalbum

# Application database schema password (required)
APP_USER_PASSWORD=

# Admin account used to authenticate photo upload/delete (state-changing endpoints).
# The user name is not a secret; the password is required and must be strong.
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# Environment consumed by the application, not by the Oracle container:
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@localhost:1521/FREEPDB1
SPRING_DATASOURCE_USERNAME=photoalbum
# Set to the same generated value as APP_USER_PASSWORD.
SPRING_DATASOURCE_PASSWORD=
