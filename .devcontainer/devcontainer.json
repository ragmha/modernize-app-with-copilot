{
  "name": "PhotoAlbum modernization: ASP.NET and Java",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0",
      "additionalVersions": "9.0"
    },
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "additionalVersions": "8",
      "jdkDistro": "tem",
      "installMaven": true,
      "mavenVersion": "3.9.11"
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "pnpmVersion": "none"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "64gb"
  },
  "remoteUser": "vscode",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "waitFor": "postCreateCommand",
  "forwardPorts": [5134, 8080],
  "portsAttributes": {
    "5134": { "label": "ASP.NET PhotoAlbum", "onAutoForward": "notify", "protocol": "http" },
    "8080": { "label": "Java PhotoAlbum", "onAutoForward": "notify", "protocol": "http" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-dotnettools.csharp",
        "vscjava.vscode-java-pack",
        "ms-azuretools.vscode-bicep"
      ]
    }
  }
}
