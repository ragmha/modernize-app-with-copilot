{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Successful two-track Azure deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "sourceSha", "runId", "runAttempt", "tracks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "sourceSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "runId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "runAttempt": { "type": "integer", "minimum": 1, "maximum": 9999 },
    "tracks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dotnet", "java"],
      "properties": {
        "dotnet": { "$ref": "#/$defs/track" },
        "java": { "$ref": "#/$defs/track" }
      }
    }
  },
  "$defs": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["imageDigest", "containerApp", "url", "smokePassed"],
      "properties": {
        "imageDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "containerApp": { "type": "string", "pattern": "^ca-(dotnet|java)-[a-z0-9]{13}$" },
        "url": { "type": "string", "format": "uri", "pattern": "^https://ca-(dotnet|java)-[a-z0-9]{13}\\.[a-z0-9.-]+\\.azurecontainerapps\\.io/?$" },
        "smokePassed": { "const": true }
      }
    }
  }
}
